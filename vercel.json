{
  "version": 2,
  "name": "ngo-data-platform",
  "installCommand": "npm ci",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "app.js",
          "charts.js",
          "export.js",
          "analytics.js",
          "collect.js",
          "organization-and-reset.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
