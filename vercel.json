{
  "version": 2,
  "name": "ngo-data-platform",
  "installCommand": "npm ci",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lib/**",
          "routes/**",
          "db/**",
          "api/**",
          "email/**",
          "*.html",
          "*.css",
          "ui-helpers.js",
          "app-state.js",
          "loading.js",
          "client-router.js",
          "dashboard.js",
          "app.js",
          "charts.js",
          "export.js",
          "analytics.js",
          "collect.js",
          "organization-and-reset.js",
          "package.json",
          "package-lock.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
