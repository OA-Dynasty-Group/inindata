{
  "version": 2,
  "name": "ngo-data-platform",
  "env": {
    "NODE_ENV": "production",
    "FIELDWORK_PORT": "3000"
  },
  "buildCommand": "npm ci",
  "devCommand": "npm start",
  "installCommand": "npm ci",
  "framework": "node",
  "functions": {
    "server.js": {
      "runtime": "nodejs18.x",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
