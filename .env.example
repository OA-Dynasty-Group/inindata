# Fieldwork Environment Configuration
# Copy to .env and configure one of the database options below

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# File-based storage is no longer supported
# ============================================

# OPTION 1: SUPABASE (RECOMMENDED for serverless/Vercel)
# Required: Set both SUPABASE_URL and SUPABASE_ANON_KEY
# Get these from: https://app.supabase.com → Settings → API Keys
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGc...xxx

# OPTION 2: POSTGRESQL (self-hosted or managed)
# Required: Set DATABASE_URL or DATABASE_URL_PGBOUNCER
# Examples:
#   DATABASE_URL=postgresql://user:password@localhost:5432/fieldwork
#   DATABASE_URL_PGBOUNCER=postgresql://user:password@pgbouncer.example.com:6432/fieldwork

# ============================================
# APPLICATION SETTINGS
# ============================================

# TCP port the server listens on (default: 3000)
FIELDWORK_PORT=3000

# Bootstrap password for initial admin user (change on first login)
FIELDWORK_BOOTSTRAP_PASSWORD=change-me-now

# Application environment (development or production)
NODE_ENV=development

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Public application URL (for production deployments)
# FIELDWORK_PUBLIC_URL=https://app.example.org

# Session cookie settings (for production)
# COOKIE_SECURE=true
# TRUST_PROXY=1

# Enable debug logging for database operations
# DEBUG=true

# Email notifications (Titan Mail)
# EMAIL_ENABLED=true
# TITANMAIL_HOST=smtp.titanmail.io
# TITANMAIL_USER=your-titanmail-username
# TITANMAIL_PASSWORD=your-titanmail-password
# EMAIL_FROM=noreply@example.org

# ============================================
# DEPLOYMENT INSTRUCTIONS
# ============================================

# For local development:
#   1. Copy this file to .env
#   2. Leave SUPABASE_* and DATABASE_* unset
#   3. Run: npm install && npm start
#   4. Data saved to data/store.json

# For Vercel + Supabase (FREE TIER):
#   1. Create Supabase account (https://supabase.com)
#   2. Create new project (postgres db auto-created)
#   3. Get SUPABASE_URL and SUPABASE_ANON_KEY from Settings → API Keys
#   4. Create PostgreSQL schema: Run db/001_initial_schema.sql in SQL Editor
#   5. Push code to GitHub
#   6. Connect to Vercel and set env vars in project settings
#   7. Deploy!

# For more details, see SUPABASE_VERCEL_DEPLOYMENT.md
# EMAIL CONFIGURATION (Phase 2 - OPTIONAL)
# ============================================

# Enable email notifications
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=titanmail
# EMAIL_FROM=notifications@yourdomain.com

# Titan Mail Configuration (RECOMMENDED)
# Get credentials from https://www.titanmail.io/
# Support: SMTP with TLS on port 587 or SSL on port 465
# TITANMAIL_HOST=smtp.titanmail.io
# TITANMAIL_PORT=587
# TITANMAIL_USER=your-email@yourdomain.com
# TITANMAIL_PASSWORD=your-app-password

# Alternative: SendGrid Configuration
# Get API key from https://sendgrid.com/
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Alternative: Development Mode (logs to console)
# EMAIL_PROVIDER=dev
# (Useful for testing without sending real emails)

# ============================================
# CONNECTION STRING FORMATS
# ============================================

# Direct Connection (Local Development - Port 5432)
# postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# PgBouncer Connection (Production/Vercel - Port 6543)
# postgresql://postgres.xxxxx:PASSWORD@db.xxxxx.supabase.co:6543/postgres

# Note: PgBouncer is required for serverless deployments
# It multiplexes connections across instances and prevents timeouts

# ============================================
# GETTING STARTED
# ============================================

# 1. For local development with file storage:
#    Just set FIELDWORK_BOOTSTRAP_PASSWORD and run: npm start

# 2. For local development with Supabase:
#    - Create Supabase project: https://supabase.com
#    - Apply schema from db/001_initial_schema.sql
#    - Set DATABASE_URL with direct connection
#    - Run: npm run dev

# 3. For production (Vercel):
#    - See SUPABASE_VERCEL_DEPLOYMENT.md for full instructions
#    - Set DATABASE_URL_PGBOUNCER in Vercel dashboard
#    - Set FIELDWORK_BOOTSTRAP_PASSWORD in Vercel dashboard
#    - Deploy via GitHub → Vercel integration

